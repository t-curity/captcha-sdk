{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "baseUrl": ".",
    "strict": true,
    "outDir": "dist",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "lib": ["DOM", "ES2018"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
